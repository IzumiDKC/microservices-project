  <bpmn:process id="process_report_post" name="Report Process" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="Event_0do7am8" name="Người dùng báo cáo" />
    <bpmn:userTask id="Activity_1eqw1di" name="Admin duyệt bài" camunda:formKey="embedded:app:forms/report-approval.html" camunda:assignee="admin">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0rb3q7m" name="Có vi phạm không?">
      <bpmn:outgoing>Flow_1juiqki</bpmn:outgoing>
      <bpmn:outgoing>Flow_1n4pvmu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_178epbl" name="Xóa bài viết" camunda:delegateExpression="${deletePostDelegate}">
      <bpmn:incoming>Flow_1juiqki</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1juiqki" name="Có" sourceRef="Gateway_0rb3q7m" targetRef="Activity_178epbl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isViolation == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_158zs3g">
      <bpmn:incoming>Flow_1n4pvmu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1n4pvmu" name="Không" sourceRef="Gateway_0rb3q7m" targetRef="Event_158zs3g">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isViolation == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
